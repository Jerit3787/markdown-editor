{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markdown-editor",
  "main": "src/worker.ts",
  "compatibility_date": "2025-08-01",
  // Needed for isomorphic-git (used server-side to push published-gist
  // images as real files via git's smart-HTTP protocol, since gist's REST
  // API can't store true binary content — see src/gist-images.ts).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },

  "routes": [
    { "pattern": "editor.danplace.tech", "custom_domain": true }
  ],

  // GITHUB_CLIENT_ID is the public half of the GitHub OAuth App (Settings
  // → Developer settings → OAuth Apps) used for "Sign in with GitHub" /
  // Gist publish. GITHUB_CLIENT_SECRET and SESSION_SECRET are Worker
  // secrets (wrangler secret put ...), never committed.
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23liV4lb0YiRtTwpm9"
  },

  // Serves the built client (client/dist/, produced by `npm run build` —
  // see client/) for any request the Worker doesn't explicitly handle
  // itself. single-page-application fallback serves index.html for pretty
  // share URLs like /d/<docId>/edit that aren't real files (see
  // client/src/collab.ts). run_worker_first is required alongside it:
  // without it, Cloudflare's asset layer treats ANY extensionless
  // page-navigation request (not just unmatched ones) as an SPA route and
  // serves index.html before src/worker.ts's own routing ever runs — which
  // silently broke full-page-navigation endpoints like
  // /api/auth/github/login (fetch()-based /api calls were unaffected,
  // since only real navigations hit this). With run_worker_first, the
  // Worker's own routing (which already checks /api/* before falling
  // through to env.ASSETS.fetch()) always runs first.
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // One Durable Object instance per collaboration room, holding that room's
  // Yjs document in memory and checkpointing it to its own built-in storage
  // — no external database involved. Images are embedded as base64 data
  // URIs client-side instead of uploaded anywhere (see js/app.js), so no
  // R2 bucket or upload quota is needed.
  "durable_objects": {
    "bindings": [
      { "name": "COLLAB_ROOM", "class_name": "CollabRoom" },
      { "name": "WORKSPACE_ROOM", "class_name": "WorkspaceRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CollabRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ImageQuota"] },
    { "tag": "v3", "deleted_classes": ["ImageQuota"] },
    { "tag": "v4", "new_sqlite_classes": ["WorkspaceRoom"] }
  ]
}
