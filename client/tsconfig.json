{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    /* strictNullChecks off (only here — the backend tsconfig at the repo
       root keeps full strict mode): this code is the direct port of the
       pre-existing vanilla DOM app (document.getElementById() etc.
       everywhere, always assumed non-null since the elements are static
       and always present in index.html). Phase 3 of the migration plan
       replaces this file-by-file with Svelte components with real typed
       props/stores — exhaustively null-guarding hundreds of DOM queries
       in code that's being deleted soon isn't where the value is. Other
       strict checks (no-implicit-any, etc.) still apply and catch real
       mistakes. */
    "strictNullChecks": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
