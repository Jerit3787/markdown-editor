{
  "name": "markdown-editor",
  "private": true,
  "version": "1.26.1",
  "type": "module",
  "license": "MIT",
  "description": "A fast, static markdown editor with live preview and real-time multi-user collaboration.",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "dev:client": "vite dev --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^20.19.43",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "svelte": "^5.56.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.19.1"
  },
  "overrides": {
    "undici": "^8.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@panzoom/panzoom": "^4.6.2",
    "@replit/codemirror-emacs": "^6.1.0",
    "@replit/codemirror-vim": "^6.4.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.13",
    "html2pdf.js": "^0.14.0",
    "isomorphic-git": "^1.40.0",
    "katex": "^0.18.4",
    "lib0": "^0.2.99",
    "marked": "^18.0.0",
    "marked-footnote": "^1.4.0",
    "mermaid": "^11.16.1",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.18"
  }
}
