{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markdown-editor",
  "main": "src/worker.js",
  "compatibility_date": "2025-08-01",
  "workers_dev": false,

  "routes": [
    { "pattern": "editor.danplace.tech", "custom_domain": true }
  ],

  // Serves the static site (public/) for any request the Worker doesn't
  // explicitly handle itself (i.e. everything except /api/collab/*).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // R2 bucket for images pasted/dropped into documents. Uploads are gated
  // by ImageQuota (below) so this can never run past the R2 free tier.
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "markdown-editor-images" }
  ],

  // One Durable Object instance per collaboration room, holding that room's
  // Yjs document in memory and checkpointing it to its own built-in storage
  // — no external database involved. ImageQuota is a single global instance
  // that enforces a hard total-storage cap and a per-IP upload rate limit.
  "durable_objects": {
    "bindings": [
      { "name": "COLLAB_ROOM", "class_name": "CollabRoom" },
      { "name": "IMAGE_QUOTA", "class_name": "ImageQuota" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CollabRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ImageQuota"] }
  ]
}
